APP_NAME=DoLean Backend
APP_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO
POSTGRES_USER=dolean
POSTGRES_PASSWORD=change-me-local
POSTGRES_DB=dolean
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://dolean:change-me-local@db:5432/dolean
REDIS_URL=redis://redis:6379/0
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-minio
MINIO_SECURE=false
MINIO_BUCKET=audio-files
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
JWT_SECRET_KEY=change-me-local-jwt-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_EXPIRE_MINUTES=30
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM_EMAIL=no-reply@dolean.local
PASSWORD_RESET_URL=http://localhost:3000/reset-password

